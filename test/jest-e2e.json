{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "useESM": true, "tsconfig": "<rootDir>/../tsconfig.test.json" }]
  },
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {
    "@/(.*)": "<rootDir>/../src/$1"
  }
}
